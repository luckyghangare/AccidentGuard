# AccidentGuard Backend Configuration Template

APP_NAME="AccidentGuard API"
DEBUG=True

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=accidentguard_db

# Security
SECRET_KEY="your-super-secret-key-change-me"
ALGORITHM=HS256

# Firebase Cloud Messaging (FCM)
# Path to your service-account.json file
FIREBASE_SERVICE_ACCOUNT_PATH="app/secrets/service-account.json"
FIREBASE_PROJECT_ID="accidentguard-xxxx"
